#include <stdio.h>
#include <stdlib.h>
int main(){
    int n;
    scanf("%d",&n);
    int *arr = (int*)malloc(sizeof(int)*n);
    for(int i = 0; i<n; i++){
        scanf("%d",arr+i);
    }
    if(n == 1) printf("yes");
    else{
        int i = 0;
        while(i < n-2){
            if((arr[i+1]-arr[i])!=(arr[i+2]-arr[i+1])) {
                printf("no");
                i = n;
                break;
            }
            i++;
        }
        if(i!=n) printf("yes");
    }
    
}
