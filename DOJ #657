#include <stdio.h>
#include <stdlib.h>

int arr[169231];
int count[169231];

int cmp(const void *a, const void *b) {
    int x = *(int *)a;
    int y = *(int *)b;
    if (x > y) return -1;
    else if (x < y) return 1;
    else return 0;
}

int main() {
    int n, k;
    scanf("%d %d", &n, &k);
    for (int i = 0; i < n; i++) {
        scanf("%d", arr + i);
        count[i] = arr[i];
    }

    qsort(arr, n, sizeof(int), cmp);
    int min = arr[k - 1];   // K번째로 큰 값

    int tf = 0;
    for (int i = 0; i < n; i++) {
        if (count[i] >= min) tf++;
    }
    printf("%d\n", tf);

    for (int i = 0; i < n; i++) {
        if (count[i] >= min) printf("%d ", i + 1);
    }
    return 0;
}
