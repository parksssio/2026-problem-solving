#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char name[20];
    int score;
}info;

int main(){
    int n;
    scanf("%d",&n);
    info *arr = (info *)malloc(sizeof(info)*n);
    for(int i = 0; i<n; i++){
        scanf("%s %d",arr[i].name,&arr[i].score);
    }
    info tmp;
    for(int j = 0; j<n-1; j++){
        for(int i = 0; i<n-1-j; i++){
            if(arr[i].score < arr[i+1].score){
                tmp = arr[i];
                arr[i] = arr[i+1];
                arr[i+1] = tmp;
            }
        }
    }
    printf("%s",arr[2].name);
}
